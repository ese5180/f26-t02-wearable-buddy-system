mainmenu "BuddyGuard"

source "Kconfig.zephyr"

menu "BuddyGuard prototype"

config BUDDYGUARD_WIFI
	bool "Direct Wi-Fi HTTPS telemetry and OTA"
	depends on BUDDYGUARD_FLEET && WIFI
	default n

config BUDDYGUARD_FLEET
	bool "Memfault fleet diagnostics over the USB host gateway"
	depends on MEMFAULT
	default n

config BUDDYGUARD_DEVICE_SERIAL
	string "Unique cloud device serial"
	default "BG-T01"
	depends on BUDDYGUARD_FLEET

config BUDDYGUARD_COUNSELOR
	bool "Build the counselor receiver role"
	default n

config BUDDYGUARD_IMU
	bool "Optional SparkFun LSM6DSO on the tag I2C bus"
	depends on !BUDDYGUARD_COUNSELOR
	select SENSOR
	select I2C
	help
	  Poll a deferred LSM6DSO at address 0x6b or 0x6a. Missing or stale
	  measurements produce UNKNOWN and do not block the wireless service.

config BUDDYGUARD_IMPACT_THRESHOLD_MG
	int "Impact: single-axis change between consecutive IMU samples (mg)"
	depends on BUDDYGUARD_IMU
	range 300 3900
	default 1000
	help
	  An impact (possible fall or hard knock) queues one LoRa SOS and pulses
	  the impact-gpios marker so a logic analyzer can time it.

config BUDDYGUARD_IMPACT_LOCKOUT_MS
	int "Impact: ignore further impacts for this long after one fires"
	depends on BUDDYGUARD_IMU
	range 500 60000
	default 3000

config BUDDYGUARD_IMPACT_MARKER_MS
	int "Impact: marker pulse width on the zephyr,user impact-gpios pin"
	depends on BUDDYGUARD_IMU
	range 1 1000
	default 50

config BUDDYGUARD_PRESENCE_ADV_INTERVAL_MS
	int "Presence (non-connectable) advertising minimum interval; maximum is 1.5x"
	range 100 6000
	default 100
	help
	  100 keeps the original 100-150 ms interval. The low-power profile raises
	  it; the presence sequence still changes every 2 s.

config BUDDYGUARD_PRESENCE_TIMEOUT_MS
	int "BLE presence timeout for the laboratory demo"
	range 4000 120000
	default 8000

config BUDDYGUARD_TAG_ID
	int "Laboratory tag ID"
	range 1 255
	default 1

config BUDDYGUARD_MAINTENANCE_GRACE_SECONDS
	int "Roster grace for a tag whose last frame announced maintenance"
	range 120 900
	default 600
	help
	  A 244-byte BLE SMP upload takes several minutes while advertisements
	  pause. Keep this separate from the normal missing-tag timeout, and
	  bounded so a stalled update cannot suppress warnings indefinitely.

config BUDDYGUARD_CONFIRM_AFTER_SECONDS
	int "Healthy runtime before confirming a test image"
	range 5 300
	default 15

config BUDDYGUARD_MAINTENANCE_SECONDS
	int "Initial laboratory BLE maintenance window"
	range 0 600
	default 300

config BUDDYGUARD_FAULT_ON_BOOT
	bool "Inject an unconfirmed-image failure after watchdog setup"
	default n
	help
	  Test images only: stop feeding the watchdog before image confirmation.

endmenu
