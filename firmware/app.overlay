#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/lora/sx126x.h>

/ {
	aliases {
		lora0 = &wio_lora;
	};

	wio_keys: wio-keys {
		compatible = "gpio-keys";
		debounce-interval-ms = <25>;

		user-button {
			gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_BTN_0>;
		};
	};

	wio_longpress: wio-longpress {
		compatible = "zephyr,input-longpress";
		input = <&wio_keys>;
		input-codes = <INPUT_BTN_0>;
		long-codes = <INPUT_BTN_1>;
		long-delay-ms = <1000>;
	};
};

/* On the B2B kit the USER switch shares GPIO21 with the XIAO LED. */
&led0 {
	status = "disabled";
};

/* ESP32S3 B2B kit, not the nRF52840 through-hole module pinout.
 * GPIO32..53 are gpio1 pins 0..21.
 */
&spi2 {
	cs-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>; /* GPIO41 NSS */
	wio_lora: sx1262@0 {
		compatible = "semtech,sx1262";
		zephyr,deferred-init;
		reg = <0>;
		spi-max-frequency = <2000000>;
		reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>; /* GPIO42 */
		busy-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>; /* GPIO40 */
		dio1-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>; /* GPIO39 */
		antenna-enable-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>; /* GPIO38 */
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_3V0>;
		tcxo-power-startup-delay-ms = <10>;
		status = "okay";
	};
};
